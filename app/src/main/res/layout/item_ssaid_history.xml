<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_ssaid_item"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/historyTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/on_surface_variant"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_code_box"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/historyValues"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/on_surface"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/restoreHistoryButton"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_chip_button"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="0dp"
        android:text="@string/restore_old_value"
        android:textAllCaps="false"
        android:textColor="@color/primary"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
